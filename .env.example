# Copy this file to .env, then replace the password with the same strong password
# configured when creating the Neo4j database. Never commit the populated .env.

# Local Neo4j Desktop / Community 5.x or the project's Docker Compose service
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# For Neo4j Aura, replace the local settings above with your Aura connection
# URI, configured username, password, and database name.
# NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=<your-aura-password>
# NEO4J_DATABASE=neo4j

# Application settings
APP_NAME=Case-Graph-Intelligence-Backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DEBUG=True

# Optional exact browser origins for a separately hosted frontend (comma-separated).
# Same-origin deployments can leave this empty. Never use '*' with credentials.
CORS_ORIGINS=

# Graph analysis settings
DEFAULT_MAX_PATH_DEPTH=5
ENABLE_GDS=True

# Optional hosted AI service
GEMINI_API_KEY=

# Optional blockchain ledger path (defaults to data/blockchain_ledger.json)
BLOCKCHAIN_LEDGER_PATH=
